# 服务端口
PORT=3000

# MySQL 连接（先执行 db/schema.sql 建库建表）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=wc_watermark

# JWT 签名密钥（务必改成随机长字符串）
JWT_SECRET=please-change-me-to-a-random-long-string

# 微信小程序凭证（微信公众平台 → 开发管理 → 开发设置）
# 不配置时走开发模式：openid 用 code 哈希模拟，仅限本地调试
WX_APPID=
WX_SECRET=

# 上传文件目录（相对 server 目录或绝对路径；也可在后台「配置 → 存储路径」里改）
UPLOAD_DIR=uploads

# FFmpeg（视频去水印依赖）。留空 = 自动探测：先找项目内置 tools/bin/ffmpeg(.exe)，再找系统 PATH。
# 通常留空即可，项目换电脑 / 换盘都不用改。只有在想用别处的 FFmpeg 时才填绝对路径。
FFMPEG_PATH=
FFPROBE_PATH=

# 首次启动时若 settings 表没有密钥，用这个作为初始后台密钥（不填则自动随机生成）
INIT_ADMIN_KEY=
