# 监听端口（本地 3100；云托管一般由平台注入 PORT，不用改）
PORT=3100

# 静态令牌：与小程序 utils/constants.js 的 VIDEO_CLIENT_TOKEN 保持一致
# 留空则不校验 —— 只建议本地调试时留空，公网部署必须设置
CLIENT_TOKEN=

# 单个视频大小上限（MB）
MAX_SIZE_MB=500

# 单个视频时长上限（秒），0 表示不限制
MAX_DURATION=60

# 产物保留时长（小时），到期自动删除
KEEP_HOURS=24

# 同时转码的任务数，小机器保持 1
CONCURRENCY=1

# 对外访问地址（可选）。不填时按请求的 Host 头自动拼接
# 反向代理 / 云托管场景建议显式配置，例如：
# PUBLIC_BASE_URL=https://xxxx.sh.run.tcloudbase.com

# FFmpeg 路径（可选）。不填时按「项目内置 tools/bin → 系统 PATH」顺序查找
# FFMPEG_PATH=
# FFPROBE_PATH=
