<view class="page">
  <nav-bar title="全能AI去水印" />

  <view class="page-body">
    <!-- 本地存储占用 -->
    <view wx:if="{{storageText}}" class="quota-line">
      <view class="flex-1">{{storageText}}</view>
    </view>

    <!-- 两个入口 -->
    <view class="entries">
      <view class="entry entry-blue" bindtap="goImage" hover-class="entry-hover">
        <view class="entry-icon entry-icon-blue">
          <view class="ic-img"></view>
        </view>
        <view class="flex-1">
          <view class="entry-tt">图片去水印</view>
          <view class="entry-dd">涂抹 / 框选 / 裁剪 · 本地处理</view>
        </view>
        <view class="entry-go entry-go-blue">›</view>
      </view>

      <view
        class="entry {{videoServiceEnabled ? 'entry-green' : 'entry-off'}}"
        bindtap="goVideo"
        hover-class="entry-hover"
      >
        <view class="entry-icon {{videoServiceEnabled ? 'entry-icon-green' : 'entry-icon-off'}}">
          <view class="ic-vid"></view>
        </view>
        <view class="flex-1">
          <view class="entry-tt">视频去水印</view>
          <view class="entry-dd">{{videoHint}}</view>
        </view>
        <view class="entry-go">{{videoServiceEnabled ? '›' : '!'}}</view>
      </view>
    </view>

    <!-- 最近处理 -->
    <view class="sect">
      <view class="sect-head">
        <view class="t-card">最近处理</view>
        <view class="sect-more" bindtap="goRecords">全部 ›</view>
      </view>

      <!-- 骨架 -->
      <view wx:if="{{recentLoading}}" class="recent-track-static">
        <view class="recent-item">
          <view class="skeleton recent-thumb"></view>
          <view class="skeleton sk-line"></view>
        </view>
        <view class="recent-item">
          <view class="skeleton recent-thumb"></view>
          <view class="skeleton sk-line"></view>
        </view>
        <view class="recent-item">
          <view class="skeleton recent-thumb"></view>
          <view class="skeleton sk-line"></view>
        </view>
      </view>

      <scroll-view
        wx:elif="{{recent.length}}"
        scroll-x
        class="recent-scroll"
        enhanced
        show-scrollbar="{{false}}"
      >
        <view class="recent-track">
          <view
            wx:for="{{recent}}"
            wx:key="id"
            class="recent-item"
            data-index="{{index}}"
            bindtap="openRecent"
          >
            <view class="thumb recent-thumb">
              <image
                wx:if="{{item.thumbUrl}}"
                class="recent-img"
                src="{{item.thumbUrl}}"
                mode="aspectFill"
                lazy-load
              />
              <view wx:else class="recent-ph">{{item.type === 'video' ? '视' : '图'}}</view>
            </view>
            <view class="recent-name ellipsis">{{item.fileName}}</view>
          </view>
        </view>
      </scroll-view>

      <view wx:else class="recent-empty">
        <empty-state
          size="sm"
          icon="image"
          title="还没有处理记录"
          desc="从上方选一张图片开始"
        />
      </view>
    </view>

    <view class="foot-note" bindtap="goAbout">使用说明与隐私政策 ›</view>

    <!-- 首页底部 Banner 广告（广告位未配置时不渲染） -->
    <view wx:if="{{bannerHomeId}}" class="ad-wrap">
      <ad unit-id="{{bannerHomeId}}" ad-intervals="60" binderror="onAdError" />
    </view>

    <view class="page-bottom-hold"></view>
  </view>
</view>
