.editor {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f3;
  overflow: hidden;
}

/* 区域预览 */
.stage {
  position: relative;
  margin: 0 32rpx;
  height: 44vh;
  min-height: 380rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #e5e3dc;
  flex-shrink: 0;
}

.stage-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
  z-index: 1;
}

/* 视频层（与画布同层共存，播放不打断框选） */
.stage-video {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  background: #000000;
}

/* 透明热区：只接管 canvas 未覆盖的角落，负责播放/暂停点击 */
.stage-hit {
  position: absolute;
  left: 0;
  top: 56%;
  width: 28%;
  height: 32%;
  z-index: 3;
}

.stage-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
}

/* 未显示选区时整层穿透，避免空 canvas 吞掉所有触摸 */
.stage-canvas-pass {
  pointer-events: none;
}

/* 播放状态角标 */
.stage-badge {
  position: absolute;
  left: 20rpx;
  top: 20rpx;
  padding: 6rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #ffffff;
  font-size: 22rpx;
  z-index: 5;
  pointer-events: none;
}

/* 舞台底部操作条 */
.stage-bar {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  left: 20rpx;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 14rpx;
  z-index: 5;
}

.sbar-btn {
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #ffffff;
  font-size: 23rpx;
  line-height: 1.3;
}

.sbar-btn.primary {
  background: rgba(15, 110, 86, 0.92);
}

.stage-fallback {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  text-align: center;
  font-size: 26rpx;
  color: #888780;
  line-height: 1.7;
  z-index: 4;
  pointer-events: none;
}

/* 提示（已随模式切换移除，保留以免历史引用报错） */
.stage-tip {
  display: none;
}

/* 面板 */
.panel {
  padding: 24rpx 32rpx 0;
}

.hl {
  color: #0f6e56;
  font-weight: 500;
}

.mode-desc {
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 时间轴 */
.tl {
  position: relative;
  height: 64rpx;
  margin-top: 8rpx;
}

.tl-track {
  position: absolute;
  left: 0;
  right: 0;
  top: 22rpx;
  height: 20rpx;
  border-radius: 10rpx;
  background: #e5e3dc;
}

.tl-sel {
  position: absolute;
  top: 22rpx;
  height: 20rpx;
  border-radius: 10rpx;
  background: rgba(15, 110, 86, 0.28);
  border-top: 1rpx solid #0f6e56;
  border-bottom: 1rpx solid #0f6e56;
}

.tl-h {
  position: absolute;
  top: 12rpx;
  width: 12rpx;
  height: 40rpx;
  border-radius: 6rpx;
  background: #0f6e56;
  transform: translateX(-50%);
}

/* 播放位置游标 */
.tl-cursor {
  position: absolute;
  top: 4rpx;
  width: 4rpx;
  height: 56rpx;
  border-radius: 2rpx;
  background: #d14b3c;
  transform: translateX(-50%);
  box-shadow: 0 0 6rpx rgba(209, 75, 60, 0.6);
}

.tl-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 22rpx;
  color: #b4b2a9;
  margin-top: 4rpx;
}

.tl-time {
  font-size: 22rpx;
  color: #b4b2a9;
}

.tl-mid {
  font-size: 24rpx;
  color: #0f6e56;
  font-weight: 500;
}

.tl-actions {
  display: flex;
  gap: 32rpx;
  margin-top: 16rpx;
}

.link {
  font-size: 26rpx;
  color: #185fa5;
}

/* 遮罩 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
}

.mask-card {
  width: 520rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 48rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.mask-label {
  font-size: 30rpx;
  font-weight: 500;
  color: #2c2c2a;
}

.bar {
  width: 100%;
  height: 10rpx;
  background: #f1efe8;
  border-radius: 5rpx;
  margin-top: 32rpx;
  overflow: hidden;
}

.bar-in {
  height: 100%;
  background: #0f6e56;
  border-radius: 5rpx;
  transition: width 0.2s linear;
}

.mask-pct {
  font-size: 26rpx;
  color: #0f6e56;
  margin-top: 18rpx;
  font-weight: 500;
}

.mask-tip {
  font-size: 22rpx;
  color: #b4b2a9;
  margin-top: 24rpx;
  text-align: center;
  line-height: 1.6;
}
