<view class="editor">
  <nav-bar showBack title="视频去水印" />

  <!-- 区域预览：video 与 canvas 同层共存，播放 / 暂停 / 框选互不打断 -->
  <view class="stage">
    <video
      wx:if="{{src}}"
      id="vEdit"
      class="stage-video"
      src="{{src}}"
      object-fit="contain"
      show-center-play-btn="{{false}}"
      show-play-btn="{{false}}"
      show-fullscreen-btn="{{false}}"
      show-progress="{{false}}"
      show-bottom-progress="{{false}}"
      enable-progress-gesture="{{false}}"
      controls="{{false}}"
      muted="{{vMuted}}"
      binderror="onEditError"
      bindtimeupdate="onEditTime"
      bindplay="onEditPlay"
      bindpause="onEditPause"
      bindended="onEditEnded"
    ></video>
    <image wx:if="{{!src && thumbSrc}}" class="stage-img" src="{{thumbSrc}}" mode="aspectFit" />
    <view wx:if="{{!src && !thumbSrc}}" class="stage-fallback">无法读取视频画面<br />请返回重新选择</view>
    <view wx:if="{{vError}}" class="stage-fallback">播放失败：{{vError}}</view>

    <!-- 透明热区：上方留出 canvas 的拖拽区，只接管 canvas 未覆盖的角落，避免与 canvas 抢事件 -->
    <view
      class="stage-hit"
      bindtap="togglePlay"
      bindlongpress="onStageLongPress"
    ></view>

    <!-- 选区画布（透明背景，叠在 video 之上；未显示选区时整层可穿透） -->
    <canvas
      type="2d"
      id="vCanvas"
      class="stage-canvas {{hasRegion ? '' : 'stage-canvas-pass'}}"
      disable-scroll
      bindtouchstart="onRegionStart"
      catchtouchmove="onRegionMove"
      bindtouchend="onRegionEnd"
      bindtouchcancel="onRegionEnd"
    ></canvas>

    <!-- 播放状态角标 -->
    <view class="stage-badge">{{playing ? '播放中' : '已暂停'}}</view>

    <!-- 电脑测试（开发者工具）状态角标：真机不显示，点一下重新探测 -->
    <view wx:if="{{simulator}}" class="sim-chip sim-{{simService}}" catchtap="checkSimService">
      <view class="sim-dot"></view>
      <view class="sim-tx" wx:if="{{simService === 'ok'}}">电脑服务已连接</view>
      <view class="sim-tx" wx:elif="{{simService === 'checking'}}">检测电脑服务…</view>
      <view class="sim-tx" wx:else>电脑服务未连接·点此重试</view>
    </view>

    <!-- 播放控制条 -->
    <view class="stage-bar">
      <view class="sbar-btn primary" bindtap="togglePlay">{{playing ? '暂停' : '播放'}}</view>
      <view class="sbar-btn" bindtap="toggleRegion">{{hasRegion ? '隐藏框' : '框选'}}</view>
      <view class="sbar-btn" bindtap="deleteSelected">删框</view>
      <view class="sbar-btn" bindtap="previewVideo">全屏</view>
    </view>
  </view>

  <!-- 处理方式 -->
  <view class="panel">
    <view class="field-label">
      <text>处理方式</text>
      <text class="mode-desc">智能去水印</text>
    </view>
    <view class="notice plain">
      <view class="notice-tx">支持一次框选最多 4 个水印：空白处拖动加框，点框选中后可拖动/缩放/删除，已选 {{regions.length}} 个。</view>
    </view>
  </view>

  <!-- 说明 -->
  <view class="panel">
    <view class="notice plain">
      <view class="notice-tx">全片处理并保留原声音，处理耗时约等于视频时长，请保持小程序在前台。</view>
    </view>
  </view>

  <view class="bottom-bar">
    <view
      class="btn-primary {{submitting ? 'disabled' : ''}}"
      bindtap="submit"
    >
      开始处理
    </view>
  </view>

  <!-- 提交遮罩 -->
  <view wx:if="{{submitting}}" class="mask">
    <view class="mask-card">
      <view class="mask-label">{{progressLabel}}</view>
      <view class="bar">
        <view class="bar-in" style="width:{{progress}}%"></view>
      </view>
      <view class="mask-pct">{{progress}}%</view>
      <view class="mask-tip">请保持小程序在前台。处理耗时约等于视频时长，长视频请耐心等待</view>
      <view class="mask-cancel" bindtap="cancelProcess">{{cancelling ? '正在取消…' : '取消处理'}}</view>
    </view>
  </view>
</view>
