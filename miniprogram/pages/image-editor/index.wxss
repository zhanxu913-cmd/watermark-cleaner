.editor {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f3;
  overflow: hidden;
}

/* 舞台 */
.stage {
  flex: 1;
  position: relative;
  margin: 0 32rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #e5e3dc;
  min-height: 300rpx;
}

.stage-img {
  width: 100%;
  height: 100%;
  display: block;
}

.stage-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.stage-loading {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  text-align: center;
  font-size: 26rpx;
  color: #888780;
}

.orig-badge {
  position: absolute;
  left: 20rpx;
  bottom: 20rpx;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #ffffff;
  font-size: 24rpx;
}

/* 工具栏 */
.tools {
  padding: 24rpx 32rpx 0;
}

.tool-row {
  display: flex;
  gap: 16rpx;
}

.seg {
  margin-top: 22rpx;
  height: 76rpx;
  background: #f1efe8;
  border-radius: 20rpx;
  display: flex;
  padding: 6rpx;
}

.seg-it {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #5f5e5a;
  border-radius: 15rpx;
}

.seg-it.on {
  background: #ffffff;
  color: #2c2c2a;
  font-weight: 500;
}

.slider-wrap {
  margin-top: 24rpx;
}

.slider-wrap slider {
  margin: 0 0 0 -8rpx;
}

.mode-wrap {
  margin-top: 24rpx;
}

.mode-desc {
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 处理遮罩 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
}

.mask-card {
  width: 520rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 48rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.mask-label {
  font-size: 30rpx;
  font-weight: 500;
  color: #2c2c2a;
}

.bar {
  width: 100%;
  height: 10rpx;
  background: #f1efe8;
  border-radius: 5rpx;
  margin-top: 32rpx;
  overflow: hidden;
}

.bar-in {
  height: 100%;
  background: #378add;
  border-radius: 5rpx;
  transition: width 0.2s linear;
}

.mask-pct {
  font-size: 26rpx;
  color: #185fa5;
  margin-top: 18rpx;
  font-weight: 500;
}

.mask-tip {
  font-size: 22rpx;
  color: #b4b2a9;
  margin-top: 24rpx;
  text-align: center;
}

/* 隐藏的处理画布 */
.work-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 300px;
  height: 300px;
}
