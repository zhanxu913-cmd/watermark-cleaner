.nav-act {
  font-size: 26rpx;
  color: #185fa5;
}

/* 搜索 */
.search-wrap {
  padding: 8rpx 32rpx 0;
}

.search {
  height: 88rpx;
  border-radius: 22rpx;
  background: #f1efe8;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 0 26rpx;
}

.search-ic {
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid #b4b2a9;
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
}

.search-ic::after {
  content: '';
  position: absolute;
  right: -9rpx;
  bottom: -6rpx;
  width: 12rpx;
  height: 3rpx;
  background: #b4b2a9;
  border-radius: 2rpx;
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #2c2c2a;
  height: 100%;
}

.search-clear {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #d3d1c7;
  color: #ffffff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 筛选 */
.filter-row {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx 8rpx;
}

/* 骨架 */
.sk-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 26rpx 0;
}

.sk-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.sk-t1 {
  height: 28rpx;
  width: 60%;
  border-radius: 8rpx;
}

.sk-t2 {
  height: 22rpx;
  width: 40%;
  border-radius: 8rpx;
  margin-top: 14rpx;
}

/* 底部操作条 */
.sel-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-top: 1rpx solid #e5e3dc;
  padding: 20rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 900;
}

.sel-all {
  font-size: 26rpx;
  color: #185fa5;
}

.sel-actions {
  display: flex;
  gap: 18rpx;
}

.sel-btn {
  height: 72rpx;
  padding: 0 34rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.sel-dl {
  background: #0f6e56;
  color: #ffffff;
}

.sel-clear {
  border: 1rpx solid #e5e3dc;
  color: #5f5e5a;
}

.sel-del {
  background: #a32d2d;
  color: #ffffff;
}
