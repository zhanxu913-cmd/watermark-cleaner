<view class="page">
  <nav-bar title="处理记录">
    <view slot="right" class="nav-act">
      <text wx:if="{{!selectMode}}" bindtap="toggleSelectMode">管理</text>
      <text wx:else bindtap="toggleSelectMode">完成</text>
    </view>
  </nav-bar>

  <!-- 搜索 -->
  <view class="search-wrap">
    <view class="search">
      <view class="search-ic"></view>
      <input
        class="search-input"
        value="{{keyword}}"
        placeholder="搜索文件名"
        placeholder-class="field-placeholder"
        confirm-type="search"
        bindinput="onSearchInput"
      />
      <view wx:if="{{keyword}}" class="search-clear" bindtap="clearSearch">×</view>
    </view>
  </view>

  <!-- 筛选 -->
  <view class="filter-row">
    <view
      wx:for="{{filters}}"
      wx:key="key"
      class="chip {{item.active ? 'on' : ''}}"
      data-key="{{item.key}}"
      bindtap="switchFilter"
    >
      {{item.label}}
    </view>
  </view>

  <!-- 列表 -->
  <view class="page-body">
    <!-- 首屏骨架 -->
    <block wx:if="{{loading}}">
      <view wx:for="{{skeletonRows}}" wx:key="*this" class="sk-row">
        <view class="skeleton sk-thumb"></view>
        <view class="flex-1">
          <view class="skeleton sk-t1"></view>
          <view class="skeleton sk-t2"></view>
        </view>
      </view>
    </block>

    <block wx:elif="{{list.length}}">
      <job-card
        wx:for="{{list}}"
        wx:key="id"
        job="{{item}}"
        selectable="{{selectMode}}"
        selected="{{item.checked}}"
        bindtap="onCardTap"
        bindlongpress="onCardLongPress"
        binddownload="onCardDownload"
      />
      <view wx:if="{{loadingMore}}" class="loading-more">加载中…</view>
      <view wx:elif="{{!hasMore}}" class="loading-more">已经到底了</view>
    </block>

    <empty-state
      wx:else
      icon="box"
      title="{{emptyTitle}}"
      desc="{{emptyDesc}}"
      actionText="去处理一个"
      bindaction="goHome"
    />

    <view class="page-bottom-hold"></view>
  </view>

  <!-- 多选操作条 -->
  <view wx:if="{{selectMode}}" class="sel-bar">
    <view class="sel-all" bindtap="selectAll">全选 / 取消</view>
    <view class="sel-actions">
      <view class="sel-btn sel-dl" bindtap="downloadSelected">下载 {{selectedCount}}</view>
      <view class="sel-btn sel-clear" bindtap="clearAll">清空全部</view>
      <view class="sel-btn sel-del" bindtap="removeSelected">删除 {{selectedCount}}</view>
    </view>
  </view>
</view>
