<view class="page">
  <nav-bar title="我的" />

  <view class="page-body">
    <!-- 用户卡 -->
    <view class="user-card">
      <button
        class="avatar-btn"
        open-type="chooseAvatar"
        bindchooseavatar="onChooseAvatar"
      >
        <image
          wx:if="{{user.avatarUrl}}"
          class="avatar"
          src="{{user.avatarUrl}}"
          mode="aspectFill"
        />
        <view wx:else class="avatar avatar-ph"></view>
      </button>

      <view class="flex-1">
        <input
          class="user-name"
          type="nickname"
          value="{{user.nickName}}"
          placeholder="点击设置昵称"
          placeholder-class="field-placeholder"
          confirm-type="done"
          bindblur="onNickBlur"
        />
        <view class="user-sub">{{quotaText}}</view>
      </view>

      <view wx:if="{{isAdmin}}" class="admin-chip" bindtap="goAdmin">管理后台</view>
    </view>

    <!-- 统计 -->
    <view class="sect">
      <stat-card items="{{metrics}}" />
    </view>

    <!-- 功能与设置 -->
    <view class="sect card">
      <view class="row-item" bindtap="goRecords">
        <view class="row-k">处理记录</view>
        <view class="row-r">{{recordText}} <text class="arrow">›</text></view>
      </view>
      <view class="row-item" bindtap="goNotice">
        <view class="row-k">平台公告</view>
        <view class="row-r"><text class="arrow">›</text></view>
      </view>
      <view class="row-item" bindtap="clearCache">
        <view class="row-k">清理本地数据</view>
        <view class="row-r">{{cacheText}} <text class="arrow">›</text></view>
      </view>
      <view class="row-item" bindtap="goAbout">
        <view class="row-k">使用说明</view>
        <view class="row-r"><text class="arrow">›</text></view>
      </view>
      <view class="row-item" bindtap="goPrivacy">
        <view class="row-k">版权声明与隐私政策</view>
        <view class="row-r"><text class="arrow">›</text></view>
      </view>
      <view class="row-item" bindtap="feedback">
        <view class="row-k">复制我的标识（反馈用）</view>
        <view class="row-r"><text class="arrow">›</text></view>
      </view>
    </view>

    <!-- 管理员入口 -->
    <view wx:if="{{!isAdmin}}" class="sect">
      <view class="admin-login" bindtap="adminQuickLogin">管理员登录</view>
    </view>

    <view wx:if="{{isAdmin}}" class="sect card">
      <view class="row-item" bindtap="goAdmin">
        <view class="row-k">后台管理</view>
        <view class="row-r">{{adminRoleLabel}} <text class="arrow">›</text></view>
      </view>
    </view>

    <view class="version">版本 {{version}}</view>
    <view class="page-bottom-hold"></view>
  </view>
</view>
