<view class="page">
  <nav-bar title="我的" />

  <view class="page-body">
    <!-- 本机模式说明 -->
    <view class="user-card">
      <view class="avatar avatar-ph"></view>
      <view class="flex-1">
        <view class="user-name">全能AI去水印</view>
        <view class="user-sub">图片 / 视频去水印工具</view>
      </view>
    </view>

    <!-- 统计 -->
    <view class="sect">
      <stat-card items="{{metrics}}" />
    </view>

    <!-- 功能与设置 -->
    <view class="sect card">
      <view class="row-item" bindtap="goRecords">
        <view class="row-k">处理记录</view>
        <view class="row-r">{{recordText}} <text class="arrow">›</text></view>
      </view>
      <view class="row-item" bindtap="clearCache">
        <view class="row-k">清空处理记录</view>
        <view class="row-r">{{cacheText}} <text class="arrow">›</text></view>
      </view>
      <view class="row-item" bindtap="goNotice">
        <view class="row-k">使用须知</view>
        <view class="row-r"><text class="arrow">›</text></view>
      </view>
      <view class="row-item" bindtap="goAbout">
        <view class="row-k">使用说明</view>
        <view class="row-r"><text class="arrow">›</text></view>
      </view>
      <view class="row-item" bindtap="goPrivacy">
        <view class="row-k">版权声明与隐私政策</view>
        <view class="row-r"><text class="arrow">›</text></view>
      </view>
    </view>

    <!-- 底部 Banner 广告：放在内容流末尾，下面留足占位，避免与原生 tabBar 重叠吞点击 -->
    <view wx:if="{{bannerMineId}}" class="sect banner-slot">
      <ad unit-id="{{bannerMineId}}" ad-intervals="60" binderror="onBannerError" />
    </view>
    <view wx:elif="{{showBannerPh}}" class="sect banner-ph">
      <view class="banner-ph-tx">Banner 广告位</view>
      <view class="banner-ph-sub">开发者工具内不渲染，真机可见</view>
    </view>

    <view class="version">版本 {{version}}</view>
    <view class="mine-bottom-hold"></view>
  </view>
</view>
