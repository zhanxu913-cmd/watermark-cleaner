<view class="page">
  <nav-bar showBack title="平台公告" />

  <view class="page-body">
    <view wx:if="{{loading}}" class="skeleton sk-block"></view>

    <block wx:elif="{{hasNotice}}">
      <view wx:if="{{maintenance}}" class="sect">
        <view class="notice warn">
          <view class="notice-bar"></view>
          <view class="notice-tx">{{maintenance}}</view>
        </view>
      </view>

      <view wx:if="{{notice}}" class="sect">
        <view class="notice-body">{{notice}}</view>
        <view class="copy-btn" bindtap="copy">复制公告内容</view>
      </view>
    </block>

    <empty-state
      wx:else
      icon="box"
      title="暂无公告"
      desc="有新消息时会显示在这里"
    />

    <view class="page-bottom-hold"></view>
  </view>
</view>
