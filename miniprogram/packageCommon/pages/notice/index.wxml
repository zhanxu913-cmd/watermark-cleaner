<view class="page">
  <nav-bar showBack title="使用须知" />

  <view class="page-body">
    <view class="sect">
      <view class="notice warn">
        <view class="notice-bar"></view>
        <view class="notice-tx">
          仅用于清理你拥有版权的素材。去除他人作品水印可能构成侵权。
        </view>
      </view>
    </view>

    <view wx:for="{{sections}}" wx:key="h" class="sect card">
      <view class="t-card">{{item.h}}</view>
      <view class="notice-body">{{item.p}}</view>
    </view>

    <view class="page-bottom-hold"></view>
  </view>
</view>
