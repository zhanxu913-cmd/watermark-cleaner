.mb {
  margin-bottom: 20rpx;
}

/* 步骤 */
.step {
  display: flex;
  gap: 24rpx;
  padding: 26rpx 0;
}

.step-n {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #e6f1fb;
  color: #185fa5;
  font-size: 26rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.step-t {
  font-size: 28rpx;
  font-weight: 500;
  color: #2c2c2a;
}

.step-d {
  font-size: 25rpx;
  color: #5f5e5a;
  line-height: 1.7;
  margin-top: 8rpx;
}

/* 处理方式 */
.mode-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f1efe8;
}

.mode-item:last-child {
  border-bottom: none;
}

.mode-k {
  font-size: 28rpx;
  font-weight: 500;
  color: #2c2c2a;
}

.mode-d {
  font-size: 25rpx;
  color: #5f5e5a;
  line-height: 1.7;
  margin-top: 8rpx;
}

/* 常见问题 */
.faq {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f1efe8;
}

.faq:last-child {
  border-bottom: none;
}

.faq-q {
  font-size: 27rpx;
  font-weight: 500;
  color: #2c2c2a;
}

.faq-a {
  font-size: 25rpx;
  color: #5f5e5a;
  line-height: 1.75;
  margin-top: 10rpx;
}

.build-tag {
  text-align: center;
  font-size: 22rpx;
  color: #b4b2a9;
  margin: 24rpx 0 8rpx;
}

/* 广告诊断 */
.dg {
  padding: 8rpx 0 16rpx;
  border-top: 1rpx solid var(--c-line, #ececea);
}

.dg-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 10rpx 0;
}

.dg-k {
  font-size: 24rpx;
  color: #6b6a63;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.dg-v {
  font-size: 24rpx;
  color: #23231f;
  text-align: right;
  word-break: break-all;
}

.dg-logs {
  margin-top: 12rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #f5f6f7;
  max-height: 460rpx;
  overflow-y: auto;
}

.dg-log {
  font-size: 22rpx;
  line-height: 1.7;
  color: #4a4a44;
  word-break: break-all;
}

.dg-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.dg-btn {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  padding: 18rpx 0;
  border-radius: 12rpx;
  color: #ffffff;
  background: #185fa5;
}

.dg-btn.ghost {
  color: #185fa5;
  background: #eaf1f8;
}
