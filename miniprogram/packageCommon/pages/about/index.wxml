<view class="page">
  <nav-bar showBack title="使用说明" />

  <view class="page-body">
    <!-- 版权提示 -->
    <view class="sect">
      <view class="notice warn">
        <view class="notice-bar"></view>
        <view class="notice-tx">请仅处理你拥有版权的素材。去除他人作品上的水印可能构成侵权，责任由使用者承担。</view>
      </view>
    </view>

    <!-- 使用步骤 -->
    <view class="sect">
      <view class="t-card mb">三步完成</view>
      <view
        wx:for="{{steps}}"
        wx:key="n"
        class="step"
      >
        <view class="step-n">{{item.n}}</view>
        <view class="flex-1">
          <view class="step-t">{{item.t}}</view>
          <view class="step-d">{{item.d}}</view>
        </view>
      </view>
    </view>

    <!-- 填充方式 -->
    <view class="sect">
      <view class="t-card mb">四种处理方式怎么选</view>
      <view class="card">
        <view wx:for="{{modes}}" wx:key="k" class="mode-item">
          <view class="mode-k">{{item.k}}</view>
          <view class="mode-d">{{item.d}}</view>
        </view>
      </view>
    </view>

    <!-- 常见问题 -->
    <view class="sect">
      <view class="t-card mb">常见问题</view>
      <view class="card">
        <view wx:for="{{faqs}}" wx:key="q" class="faq">
          <view class="faq-q">{{item.q}}</view>
          <view class="faq-a">{{item.a}}</view>
        </view>
      </view>
    </view>

    <!-- 广告诊断：真机看不到 console 时用它定位广告问题 -->
    <view class="sect">
      <view class="t-card mb">广告诊断</view>
      <view class="card">
        <view class="row-item" bindtap="toggleDiag">
          <view class="row-k">查看广告状态与日志</view>
          <view class="row-r"><text class="arrow">{{showDiag ? '收起' : '展开'}}</text></view>
        </view>

        <block wx:if="{{showDiag && diag}}">
          <view class="dg">
            <view class="dg-row"><text class="dg-k">额度闸门</text><text class="dg-v">{{diag.enabled ? '已开启' : '已关闭'}}</text></view>
            <view class="dg-row"><text class="dg-k">广告位</text><text class="dg-v">{{diag.unitId}}</text></view>
            <view class="dg-row"><text class="dg-k">环境</text><text class="dg-v">{{diag.platform}}</text></view>
            <view class="dg-row"><text class="dg-k">当前页面</text><text class="dg-v">{{diag.route}}</text></view>
            <view class="dg-row"><text class="dg-k">拉取状态</text><text class="dg-v">{{diag.loaded}}</text></view>
            <view class="dg-row"><text class="dg-k">最近错误</text><text class="dg-v">{{diag.lastError}}</text></view>
            <view class="dg-row"><text class="dg-k">闸门拦截原因</text><text class="dg-v">{{diag.gateError}}</text></view>
            <view class="dg-row"><text class="dg-k">剩余额度</text><text class="dg-v">{{diag.quota}} 条</text></view>
            <view class="dg-row"><text class="dg-k">今日观看</text><text class="dg-v">{{diag.daily}}</text></view>
          </view>

          <view class="dg-logs">
            <view class="dg-log" wx:for="{{diag.logs}}" wx:key="*this">{{item}}</view>
          </view>

          <view class="dg-actions">
            <view class="dg-btn" bindtap="testAd">{{testing ? '拉起中…' : '测试拉起激励视频'}}</view>
            <view class="dg-btn ghost" bindtap="clearDiag">清空日志</view>
          </view>
        </block>
      </view>
    </view>

    <!-- 隐私入口 -->
    <view class="sect">
      <view class="card">
        <view class="row-item" bindtap="goPrivacy">
          <view class="row-k">版权声明与隐私政策</view>
          <view class="row-r"><text class="arrow">›</text></view>
        </view>
      </view>
    </view>

    <view class="build-tag">构建版本 {{build}}</view>

    <view class="page-bottom-hold"></view>
  </view>
</view>
