.jc {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 22rpx 0;
}

.jc-hover {
  background: rgba(0, 0, 0, 0.02);
}

/* 选择框 */
.jc-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid #d3d1c7;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.jc-check.on {
  background: #185fa5;
  border-color: #185fa5;
}

.jc-tick {
  width: 16rpx;
  height: 9rpx;
  border-left: 3rpx solid #ffffff;
  border-bottom: 3rpx solid #ffffff;
  transform: rotate(-45deg);
  margin-top: -4rpx;
}

/* 缩略图（视频封面） */
.jc-thumb {
  width: 132rpx;
  height: 100rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
  flex-shrink: 0;
  background: #b5d4f4;
}

.jc-thumb-v {
  background: #2c2c2a;
}

.jc-img {
  width: 100%;
  height: 100%;
  display: block;
}

.jc-ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.jc-ph-img {
  width: 34rpx;
  height: 28rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 5rpx;
}

.jc-ph-play {
  width: 0;
  height: 0;
  border-left: 26rpx solid rgba(255, 255, 255, 0.92);
  border-top: 17rpx solid transparent;
  border-bottom: 17rpx solid transparent;
  margin-left: 6rpx;
}

/* 封面中央播放按钮 */
.jc-play {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 44rpx;
  height: 44rpx;
  margin-left: -22rpx;
  margin-top: -22rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.42);
  border: 2rpx solid rgba(255, 255, 255, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
}

.jc-play-tri {
  width: 0;
  height: 0;
  border-left: 14rpx solid #ffffff;
  border-top: 9rpx solid transparent;
  border-bottom: 9rpx solid transparent;
  margin-left: 4rpx;
}

/* 时长角标 */
.jc-dur {
  position: absolute;
  right: 6rpx;
  bottom: 6rpx;
  padding: 0 8rpx;
  border-radius: 6rpx;
  background: rgba(0, 0, 0, 0.60);
  color: #ffffff;
  font-size: 18rpx;
  line-height: 1.6;
}

.jc-tag {
  position: absolute;
  left: 6rpx;
  top: 6rpx;
  padding: 1rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.50);
  color: #ffffff;
  font-size: 18rpx;
  line-height: 1.5;
}

/* 格式 / 规格 标签 */
.jc-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 8rpx;
}

.jc-chip {
  padding: 1rpx 10rpx;
  border-radius: 6rpx;
  background: #eef4fb;
  color: #185fa5;
  font-size: 20rpx;
  line-height: 1.6;
}

/* 主信息 */
.jc-main {
  flex: 1;
  min-width: 0;
}

.jc-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #2c2c2a;
}

.jc-meta {
  font-size: 24rpx;
  color: #b4b2a9;
  margin-top: 8rpx;
}

.jc-err {
  font-size: 24rpx;
  color: #a32d2d;
  margin-top: 6rpx;
}

.jc-right {
  flex-shrink: 0;
}

/* 单条下载按钮 */
.jc-dl {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  border: 2rpx solid #0f6e56;
  color: #0f6e56;
  font-size: 24rpx;
  line-height: 1;
}

.jc-dl:active {
  background: rgba(15, 110, 86, 0.08);
}
