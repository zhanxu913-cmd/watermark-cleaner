@import '../../styles/admin.wxss';

/* Tab */
.tabs {
  display: flex;
  gap: 16rpx;
  padding: 8rpx 32rpx 0;
}

.tab-item {
  flex: 1;
  height: 76rpx;
  border-radius: 22rpx;
  background: #f1efe8;
  color: #5f5e5a;
  font-size: 27rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-item.on {
  background: #e6f1fb;
  color: #0c447c;
  font-weight: 500;
}

/* 分组 */
.group {
  margin-top: 36rpx;
}

.group-t {
  font-size: 26rpx;
  color: #b4b2a9;
  margin-bottom: 16rpx;
}

.sk-big {
  height: 200rpx;
  border-radius: 24rpx;
  margin-top: 20rpx;
}

.mt-20 {
  margin-top: 20rpx;
}

/* 开关行 */
.sw-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f8f7f4;
  margin-bottom: 24rpx;
}

.sw-t {
  font-size: 28rpx;
  color: #2c2c2a;
}

/* 字段内的开关：右对齐 */
.sw-inline {
  display: flex;
  justify-content: flex-end;
  padding-top: 12rpx;
}

.sw-d {
  font-size: 23rpx;
  color: #b4b2a9;
  margin-top: 6rpx;
}

.picker-value {
  color: #2c2c2a;
}

/* 密钥卡 */
.key-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 32rpx;
  border-radius: 28rpx;
  background: #e6f1fb;
  margin-top: 20rpx;
}

.key-t {
  font-size: 28rpx;
  font-weight: 500;
  color: #0c447c;
}

.key-d {
  font-size: 23rpx;
  color: #185fa5;
  margin-top: 6rpx;
}

.key-btn {
  padding: 12rpx 28rpx;
  border-radius: 22rpx;
  background: #ffffff;
  color: #185fa5;
  font-size: 24rpx;
  flex-shrink: 0;
}

/* 管理员行 */
.a-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f1efe8;
}

.a-row:last-child {
  border-bottom: none;
}

.a-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #2c2c2a;
}

.a-sub {
  font-size: 23rpx;
  color: #b4b2a9;
  margin-top: 6rpx;
}

.a-del {
  font-size: 24rpx;
  color: #a32d2d;
  padding: 10rpx 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid #f7c1c1;
  flex-shrink: 0;
}
