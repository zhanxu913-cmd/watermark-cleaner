<view class="page">
  <nav-bar showBack title="用户详情" />

  <view class="page-body">
    <block wx:if="{{loading}}">
      <view class="skeleton sk-big"></view>
      <view class="skeleton sk-big"></view>
    </block>

    <empty-state
      wx:elif="{{notFound}}"
      icon="error"
      title="用户不存在"
      desc="可能已被删除，或链接已失效"
    />

    <block wx:else>
      <!-- 头部 -->
      <view class="head">
        <image wx:if="{{user.avatarUrl}}" class="head-av" src="{{user.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="head-av head-av-ph"></view>
        <view class="flex-1">
          <view class="head-name">{{user.nickName || '微信用户'}}</view>
          <view class="head-sub">{{roleLabel}} · {{usageText}}</view>
        </view>
        <view class="badge {{badgeClass}}">{{statusLabel}}</view>
      </view>

      <view wx:if="{{user.status === 'banned' && user.banReason}}" class="sect">
        <view class="notice danger">
          <view class="notice-bar"></view>
          <view class="notice-tx">封禁原因：{{user.banReason}}</view>
        </view>
      </view>

      <!-- 基本信息 -->
      <view class="detail-card">
        <view class="d-row">
          <view class="d-k">openid</view>
          <view class="d-v" bindtap="copyOpenid">{{user.openid || '—'}}</view>
        </view>
        <view class="d-row">
          <view class="d-k">注册时间</view>
          <view class="d-v">{{createdText}}</view>
        </view>
        <view class="d-row">
          <view class="d-k">最近活跃</view>
          <view class="d-v">{{lastActiveText}}</view>
        </view>
        <view class="d-row">
          <view class="d-k">累计任务</view>
          <view class="d-v">{{user.jobCount || 0}} 条</view>
        </view>
        <view class="d-row">
          <view class="d-k">今日用量</view>
          <view class="d-v">图 {{user.usedImageToday || 0}} · 视频 {{user.usedVideoToday || 0}}</view>
        </view>
        <view class="d-row">
          <view class="d-k">配额设置</view>
          <view class="d-v">
            {{user.quotaImage == null ? '全局默认' : user.quotaImage}} 图 /
            {{user.quotaVideo == null ? '全局默认' : user.quotaVideo}} 视频
          </view>
        </view>
      </view>

      <!-- 操作 -->
      <view class="d-actions">
        <view class="d-btn" bindtap="changeRole">变更角色</view>
        <view class="d-btn" bindtap="toggleQuota">调整配额</view>
      </view>

      <!-- 配额编辑 -->
      <view wx:if="{{showQuota}}" class="detail-card">
        <view class="field">
          <view class="field-label"><text>每日图片次数</text><text>留空表示跟随全局</text></view>
          <input
            class="field-input"
            type="number"
            value="{{quotaEdit.image}}"
            placeholder="例如 20"
            placeholder-class="field-placeholder"
            data-key="image"
            bindinput="onQuotaInput"
          />
        </view>
        <view class="field">
          <view class="field-label"><text>每日视频次数</text><text>留空表示跟随全局</text></view>
          <input
            class="field-input"
            type="number"
            value="{{quotaEdit.video}}"
            placeholder="例如 2"
            placeholder-class="field-placeholder"
            data-key="video"
            bindinput="onQuotaInput"
          />
        </view>
        <view class="d-actions">
          <view class="d-btn" bindtap="toggleQuota">取消</view>
          <view class="d-btn primary" bindtap="saveQuota">保存配额</view>
        </view>
      </view>

      <!-- 危险操作 -->
      <view class="d-actions">
        <view
          class="d-btn {{user.status === 'banned' ? 'primary' : 'warn'}}"
          bindtap="toggleBan"
        >
          {{user.status === 'banned' ? '解除限制' : '封禁用户'}}
        </view>
        <view class="d-btn danger" bindtap="removeUser">删除用户</view>
      </view>

      <!-- 该用户的任务 -->
      <view class="sect">
        <view class="sect-head"><view class="t-card">最近任务</view></view>
        <view wx:if="{{jobs.length}}" class="list-card">
          <view
            wx:for="{{jobs}}"
            wx:key="id"
            class="j-row"
            data-id="{{item.id}}"
            bindtap="openJob"
          >
            <view class="j-top">
              <view class="j-name ellipsis">{{item.fileName}}</view>
              <view class="badge badge-gray">{{item.statusLabel}}</view>
            </view>
            <view class="j-meta">{{item.modeLabel}} · {{item.timeText}} · {{item.sizeText}}</view>
            <view wx:if="{{item.error}}" class="j-error ellipsis">{{item.error}}</view>
          </view>
        </view>
        <view wx:else class="empty-line">该用户还没有处理记录</view>
      </view>

      <view class="page-bottom-hold"></view>
    </block>
  </view>
</view>
