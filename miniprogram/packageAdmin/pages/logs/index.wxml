<view class="page">
  <nav-bar showBack title="操作日志" />

  <view class="filter-row">
    <view
      wx:for="{{filters}}"
      wx:key="key"
      class="chip {{item.active ? 'on' : ''}}"
      data-key="{{item.key}}"
      bindtap="switchFilter"
    >
      {{item.label}}
    </view>
  </view>

  <view class="page-body">
    <block wx:if="{{loading}}">
      <view wx:for="{{skeletonRows}}" wx:key="*this" class="sk-row">
        <view class="skeleton sk-t1"></view>
        <view class="skeleton sk-t2"></view>
      </view>
    </block>

    <block wx:elif="{{list.length}}">
      <view class="list-card">
        <view
          wx:for="{{list}}"
          wx:key="id"
          class="lg-row"
          data-index="{{index}}"
          bindtap="copyLog"
        >
          <view class="lg-dot"></view>
          <view class="flex-1">
            <view class="lg-t">{{item.actionLabel}}</view>
            <view class="lg-s">
              {{item.operatorShort}}{{item.operatorRole === 'super' ? '（超管）' : ''}} · {{item.relText}}
            </view>
            <view wx:if="{{item.target}}" class="lg-target ellipsis">对象：{{item.target}}</view>
            <view wx:if="{{item.detail}}" class="lg-detail ellipsis">{{item.detail}}</view>
          </view>
        </view>
      </view>

      <view wx:if="{{loadingMore}}" class="loading-more">加载中…</view>
      <view wx:elif="{{!hasMore}}" class="loading-more">已经到底了</view>
    </block>

    <empty-state
      wx:else
      icon="box"
      title="暂无操作日志"
      desc="后台的每一次敏感操作都会记录在这里"
    />

    <view class="page-bottom-hold"></view>
  </view>
</view>
