/* 身份卡 */
.id-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 28rpx 32rpx;
  border-radius: 28rpx;
  background: #e6f1fb;
  margin-top: 16rpx;
}

.id-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #b5d4f4;
  flex-shrink: 0;
}

.id-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #0c447c;
}

.id-role {
  font-size: 24rpx;
  color: #185fa5;
  margin-top: 6rpx;
}

.id-act {
  padding: 12rpx 24rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.7);
  color: #185fa5;
  font-size: 24rpx;
  flex-shrink: 0;
}

.id-out {
  color: #5f5e5a;
}

/* 骨架 */
.sk-m {
  height: 132rpx;
  border-radius: 20rpx;
  margin-top: 24rpx;
}

/* 卡片内边距归零（列表自带 padding） */
.pad0 {
  padding: 0 32rpx;
}

.sect-more {
  font-size: 24rpx;
  color: #b4b2a9;
}

.row-tag {
  font-size: 22rpx;
  color: #b4b2a9;
}

/* 操作日志行 */
.log-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1efe8;
}

.log-row:last-child {
  border-bottom: none;
}

.log-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #378add;
  margin-top: 14rpx;
  flex-shrink: 0;
}

.log-t {
  font-size: 27rpx;
  color: #2c2c2a;
}

.log-s {
  font-size: 23rpx;
  color: #b4b2a9;
  margin-top: 6rpx;
}

.empty-line {
  font-size: 26rpx;
  color: #b4b2a9;
  text-align: center;
  padding: 40rpx 0;
}

/* 维护 */
.maint-text {
  font-size: 25rpx;
  color: #5f5e5a;
  line-height: 1.7;
}

.maint-btn {
  margin-top: 24rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: #a32d2d;
  color: #ffffff;
  font-size: 27rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
