# ── 依赖 ────────────────────────────────────────────────
node_modules/
miniprogram_npm/

# ── 视频服务运行时数据（上传中转 + 产物）──────────────────
video-service-lite/.work/

# ── 密钥与本地配置 ──────────────────────────────────────
# 含 CLIENT_TOKEN，绝不能提交；.env.example 是模板，保留
video-service-lite/.env
*.local.env
.env.local

# ── 备份包 ──────────────────────────────────────────────
backup/

# ── 内置 FFmpeg 二进制（约 140 MB）──────────────────────
# 换电脑后执行 node tools/get-ffmpeg.js 自动重新下载
tools/bin/
tools/.tmp-video-test/

# ── 临时与测试产物 ──────────────────────────────────────
.tmp/
*.log
npm-debug.log*

# ── 微信开发者工具 / 编辑器 / 系统 ───────────────────────
project.private.config.json
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
